export const X_JUDO_SIGNED_IDENTIFIER = 'X-Judo-SignedIdentifier';

/**
 * Can be used with list / range requests.
 */
export const X_JUDO_COUNT_RECORDS = 'X-Judo-CountRecords';

/**
 * Received in responses if requested via `X_JUDO_COUNT_RECORDS`.
 */
export const X_JUDO_COUNT = 'x-judo-count';

/**
 * Apply mask, generally used by command type requests to explicitly define what should be in the response payload.
 */
export const X_JUDO_MASK = 'X-Judo-Mask';

/**
 * Mark already attached records. Can be used with range requests
 */
export const X_JUDO_MARK_SELECTED_RANGE_ITEMS = 'X-Judo-MarkSelectedRangeItems';
